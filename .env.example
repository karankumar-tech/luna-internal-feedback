# ---------------------------------------------------------------------------
# Luna Feedback API — local environment
# Never commit this file. Copy values from Supabase → Project Settings → API.
# ---------------------------------------------------------------------------

# --- Supabase (required) ----------------------------------------------------
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# service_role key (server-only; bypasses RLS). NOT the anon key.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string, used by the Supabase CLI to push migrations.
# Project Settings → Database → Connection string → URI (use the "Session" pooler
# or direct connection; replace [YOUR-PASSWORD]).
# e.g. postgresql://postgres.abcdefghijklmnop:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# Project ref (the subdomain of SUPABASE_URL), used by `supabase link`.
SUPABASE_PROJECT_REF=

# Personal access token for the Supabase CLI (Account → Access Tokens).
# Only needed if you want me to run `supabase link` / `db push` non-interactively.
SUPABASE_ACCESS_TOKEN=

# --- API auth (required) ----------------------------------------------------
# Pre-generated random secrets. Replace if you prefer your own.
# APP_API_KEY  → sent by the iOS app as  x-api-key
# ADMIN_API_KEY → used for category/feature admin routes as  x-admin-key
APP_API_KEY=
ADMIN_API_KEY=

# DASHBOARD_KEY → typed into /dashboard once; the server then keeps a signed HttpOnly session cookie
# for DASHBOARD_SESSION_DAYS (default 30). Rotating the key signs everyone out.
DASHBOARD_KEY=
DASHBOARD_SESSION_DAYS=30

# --- Server -----------------------------------------------------------------
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# IANA zone used for the created_at_ist field in responses.
APP_TIMEZONE=Asia/Kolkata

# --- Optional tuning ----------------------------------------------------------
# Postgres pool size. Keep at 1–2 on serverless (Vercel); 5 is fine for a long-running server.
DB_POOL_MAX=5
# How long (ms) the server caches the feature/category master list before re-reading it.
CATEGORY_CACHE_TTL_MS=30000

# --- AI diagnosis ---------------------------------------------------------------
# Luna logging API (list-botfetch). Server-only. Diagnosis is disabled when this or OPEN_ROUTER_KEY is missing.
LUNA_LOGS_APIKEY=
LUNA_LOGS_BASE_URL=https://stage-app.gonoise.com
# OpenRouter key + model. Cheap default; swap to google/gemini-2.5-flash-lite for ~2.5x cheaper.
OPEN_ROUTER_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
# Diagnose every negative submission automatically (true) or only when someone presses Diagnose now (false, default).
# Daily spend cap in USD, and the hour (IST) after which the day's logs are expected to have synced from phones.
DIAGNOSIS_AUTO=false
DIAGNOSIS_DAILY_BUDGET_USD=2
DIAGNOSIS_SYNC_HOUR_IST=20
# Optional: Vercel Cron calls GET /v1/admin/diagnoses/run-pending nightly with "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# --- Screenshots (ImageKit) ------------------------------------------------------
# Public/private API keys from ImageKit → Developer options. The app uploads directly to ImageKit using a
# short-lived signature from GET /v1/uploads/screenshot-auth; the private key never leaves the server.
IMAGEKIT_PUB_KEY=
IMAGEKIT_PRI_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/noisekaranikid
IMAGEKIT_FOLDER=/luna-feedback-screenshots
SCREENSHOT_MAX_BYTES=8388608
SCREENSHOT_MAX_COUNT=5

# --- Per-ticket AI chat -----------------------------------------------------------
# Follow-up questions about one ticket's diagnosis, asked from its detail page.
# Needs OPEN_ROUTER_KEY. The cap is per ticket, not per person.
DIAGNOSIS_CHAT_MAX_MESSAGES=10
# Leave empty to use OPENROUTER_MODEL. Set a stronger model here if the follow-ups need one.
DIAGNOSIS_CHAT_MODEL=

# --- Jira -------------------------------------------------------------------------
# All four are required together. Leave them empty and every Jira action answers
# "Jira integration pending"; nothing else in the app changes.
#   JIRA_BASE_URL    your Atlassian site, no trailing slash
#   JIRA_EMAIL       the Atlassian account the API token belongs to
#   JIRA_API_TOKEN   id.atlassian.com → Security → API tokens → Create
#   JIRA_PROJECT_KEY the board's project key, e.g. LUNA
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
# Issue type to create, and labels added to everything filed from here.
JIRA_ISSUE_TYPE=Bug
JIRA_LABELS=luna-feedback

# --- Dashboard accounts -----------------------------------------------------------
# Used in links that leave the app (the dashboard link inside a Jira ticket).
PUBLIC_BASE_URL=https://luna-feedback.buildsage.tech
# Master key. While true, DASHBOARD_KEY signs in as an admin however many accounts exist —
# the way back in if nobody can reach /dashboard/users. Set it to false once everyone has
# their own account; the key then only works until the first admin account exists.
DASHBOARD_KEY_LOGIN=true
# Optional. Names master-key sessions in the account log instead of "master key", and lets
# this address sign in with DASHBOARD_KEY as its password.
SUPERADMIN_EMAIL=
# Days before a password must be changed; 0 turns expiry off.
PASSWORD_MAX_AGE_DAYS=30
# How many previous passwords may not be reused.
PASSWORD_HISTORY_DEPTH=5
# Failed sign-ins before an account is locked, and for how long.
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15
