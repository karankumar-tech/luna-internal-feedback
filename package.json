{
  "name": "luna-internal-feedback-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "users:grant-admin": "tsx scripts/grant-admin.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "db:check": "node scripts/db-check.mjs",
    "db:verify": "node scripts/db-verify.mjs",
    "pages:embed": "node scripts/embed-pages.mjs",
    "catalog:build": "node scripts/build-event-catalog.mjs",
    "generate": "npm run pages:embed && npm run catalog:build",
    "predev": "npm run generate",
    "prebuild": "npm run generate",
    "pretypecheck": "npm run generate",
    "pretest": "npm run generate"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.5",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "fflate": "^0.8.3",
    "pg": "^8.23.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
